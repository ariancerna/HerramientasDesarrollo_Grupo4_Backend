# Servidor
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Supabase (Project Settings > API en supabase.com)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=xxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# Pasarela Culqi (panel.culqi.com > Desarrollo > API Keys). Usa la llave de PRUEBAS (sk_test_...)
# Si se deja vacía, los pagos con tarjeta funcionan en MODO DEMOSTRACIÓN (no se cobra nada).
CULQI_SECRET_KEY=

# Correo para recuperar contraseña (usa UNA opción). Sin ninguna, en desarrollo el código sale en la consola.
# Opción A - Brevo (recomendada: envía a cualquier correo). app.brevo.com > SMTP & API > API Keys
BREVO_API_KEY=
# Correo remitente verificado en Brevo (Senders, Domains & Dedicated IPs > Senders)
CORREO_REMITENTE=
CORREO_REMITENTE_NOMBRE=El Golazo Club
# Opción B - Resend (sin dominio propio solo envía al correo dueño de la cuenta). resend.com > API Keys
RESEND_API_KEY=
